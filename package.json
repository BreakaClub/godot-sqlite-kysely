{
  "name": "godot-sqlite-kysely",
  "version": "1.0.0",
  "description": "Kysely dialect for godot-sqlite. Adds SQLite support to Godot/GodotJS.",
  "files": [
    "src",
    "dist",
    "!dist/configs"
  ],
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postbuild": "pnpm exec tsx ./scripts/post-build.ts",
    "prettier": "prettier \"src/**/*.ts\"",
    "prettier:fix": "prettier \"src/**/*.ts\" --write",
    "watch": "tsc -w"
  },
  "exports": {
    "./*": {
      "import": {
        "default": "./dist/esm/*/index.js",
        "types": "./dist/types/esm/*/index.d.ts"
      },
      "require": {
        "default": "./dist/cjs/*/index.js",
        "types": "./dist/types/cjs/*/index.d.ts"
      }
    },
    ".": {
      "import": {
        "default": "./dist/esm/index.js",
        "types": "./dist/types/esm/index.d.ts"
      },
      "require": {
        "default": "./dist/cjs/index.js",
        "types": "./dist/types/cjs/index.d.ts"
      }
    }
  },
  "license": "MIT",
  "keywords": [
    "godot",
    "kysely",
    "godot kysely sqlite",
    "kysely godot sqlite",
    "sqlite",
    "godot sqlite",
    "godotjs"
  ],
  "author": "Breaka Club",
  "packageManager": "pnpm@10.12.1",
  "prettier": {
    "singleQuote": true
  },
  "peerDependencies": {
    "kysely": ">=0.26.0"
  },
  "devDependencies": {
    "@types/node": "~24.3.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "10.1.8",
    "kysely": "^0.28.5",
    "semantic-release": "^24.2.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "repository": "github:BreakaClub/godot-sqlite-kysely"
}
